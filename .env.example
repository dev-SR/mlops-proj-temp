# --- Shoppers project ---
LOG_LEVEL=INFO

# --- MinIO (S3-compatible store) ---
MINIO_ROOT_USER=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DVC_BUCKET=dvc
DVC_REMOTE=storage

# --- DVC / boto3 on the HOST ---
DVC_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1

POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=mlflow

MLFLOW_PORT=5500
# Host: http://localhost:5500  |  Inside containers: http://mlflow:5000
MLFLOW_TRACKING_URI=http://localhost:5500
MLFLOW_HOST_TRACKING_URI=http://localhost:5500
MLFLOW_EXPERIMENT_NAME=shoppers-purchasing-intention
MLFLOW_REGISTERED_MODEL=shoppers
MLFLOW_BUCKET=mlflow

API_PORT=8000
STREAMLIT_PORT=8501
AIRFLOW_PORT=8080
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
